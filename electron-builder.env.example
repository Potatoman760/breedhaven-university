# Copy to electron-builder.env (git-ignored) to sign and notarize the macOS build.
# electron-builder reads that file by itself; without it the build is left unsigned.

# Notarization: your Apple ID, an app-specific password made at account.apple.com,
# and the Team ID from developer.apple.com/account (Membership details).
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Signing: nothing needed when a "Developer ID Application" certificate is in the login
# keychain. To sign from an exported certificate instead, point at the .p12 here.
# CSC_LINK=/path/to/developer-id.p12
# CSC_KEY_PASSWORD=
